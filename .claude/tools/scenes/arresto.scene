// L'arresto in volante (§5.35), giocato davvero e fotografato a ogni fase.
//
// Asserisce *e* scatta: una sequenza si giudica a schermo (si capisce che sei in
// manette? che la volante arriva, ti carica e parte?) e coi numeri (finisce in
// `bustPlayer`, ESC la salta, l'autosave non parte, l'entrata in un negozio
// azzera la barra del fermo).
//
//   node .claude/tools/probe.mjs --seconds 1 --quiet \
//     --shot-dir /tmp/arresto \
//     --script .claude/tools/scenes/arresto.scene \
//     --eval "Object.entries(window.__OUT).filter(([k,v]) => v===false).map(([k])=>k)"
//
// `[]` vuol dire tutto a posto; gli scatti finiscono in `--shot-dir` (senza, la
// scena gira lo stesso e non fotografa). `window.__LOG` è la fila delle fasi.
//
// Invarianti, non si interpretano:
//   · `finisceInBust` — la sequenza chiude sempre in `bustPlayer` (stats.busted +1)
//   · `escSalta` — ESC chiude subito, in qualunque fase
//   · `nessunAutosaveDurante` — lo slot automatico non cambia mentre le manette sono addosso
//   · `missioneRipresa` — l'arresto durante una missione la riprende dalla stessa fase
//   · `campione9su10` — su dieci posti e livelli 1-3, almeno nove arresti arrivano in fondo
//   · `barraSiAzzeraNelNegozio` — il bug di `arresting`/`bustT` congelati dentro un interno
const wait = (s) => new Promise((r) => setTimeout(r, s * 1000));
const S = await import('/src/core/save.js');
const { hasLineOfSight } = await import('/src/entities/weapons.js');
const out = {};
const log = [];
const pl = game.player;
const P = game.police;
const A = game.arrest;
const shot = async (n) => { if (window.__shot) await window.__shot(n); };
const snapAuto = () => {
  try { return JSON.stringify(Object.entries(localStorage).filter(([k]) => k.startsWith('seoul.save.auto'))); } catch { return ''; }
};

game.hud.messages.length = 0;   // i suggerimenti dell'avvio coprono la scena
game.hud.districtToast = 0;
game.dayCycle.paused = true;
game.dayCycle.hour = 14;
game.dayCycle.setWeather('clear');
if (!game.missions.active) game.missions.start('m1', game);   // un arresto in missione deve riprenderla
let busts = 0;
game.on('busted', () => { busts++; });

/** Marciapiede libero accanto a una strada lunga, vicino al punto di partenza. */
function marciapiede(skip = 0, c = null) {
  const sp = c || game.city.spawn;
  const edges = game.city.graph.edgesNear(sp.x, sp.y, 900).filter((e) => e.len > 300);
  const grid = game.area().grid;
  let k = 0;
  out.marciapiedi = (out.marciapiedi || 0);
  for (const e of edges) {
    for (const side of [1, -1]) {
      const off = e.width / 2 + 22;
      const x = e.ax + e.dx * e.len * 0.5 - e.dy * off * side;
      const y = e.ay + e.dy * e.len * 0.5 + e.dx * off * side;
      const hit = grid.queryRect(x - 14, y - 14, 28, 28).filter((s) => !s.vehicleOnly).length;
      if (!hit && k++ >= skip) return { x, y };
    }
  }
  return null;
}

/** Come `preparaArresto`, ma se l'agente non sopravvive al primo mezzo secondo (un
 *  passante armato, un'auto) riprova su un altro marciapiede: non è quello che si prova. */
async function preparaArresto(skip = 0, c = null, heat = 12) {
  for (let k = 0; k < 5; k++) {
    const s = await preparaUnArresto(skip + k, c, heat);
    if (!s) return null;
    await wait(0.4);
    if (!s.cop.dead) return s;
  }
  return null;
}

async function preparaUnArresto(skip = 0, c = null, heat = 12) {
  if (game.shops.active) game.shops.leave(game);
  game.wanted.reset();
  P.standDown(game, true);
  const at = marciapiede(skip, c);
  if (!at) return null;
  pl.revive(at.x, at.y);
  pl.weapon = 'fists';
  pl.setWeapon('fists');
  pl.hp = 100;
  game.camera.snapTo(at.x, at.y);
  game.camera.setZoomTarget(1);
  await wait(0.5);
  game.wanted.add(heat, game);   // 12 = una stella, 30 = due, 60 = tre
  pl.hp = 100000;   // a due-tre stelle le volanti sparano: qui si prova la scena, non la sopravvivenza
  const cop = P.addCop(game, at.x + 30, at.y, 'cop', 'pistol');
  cop.x = at.x + 30; cop.y = at.y;
  return { at, cop };
}

async function aspettaAttiva(max = 7, quale = '') {
  const t0 = performance.now();
  while (!A.active && performance.now() - t0 < max * 1000) await wait(0.05);
  if (!A.active) {
    out[`diagnosi${quale}`] = { lvl: game.wanted.level, arresting: P.arresting, bustT: P.bustT, cops: P.cops.length,
      d: P.cops.map((c) => Math.round(Math.hypot(c.x - pl.x, c.y - pl.y))), hp: pl.hp, dying: pl.dying, indoors: game.indoors,
      mode: game.mode.id, weapon: pl.weapon, swing: pl.swingT, onFoot: pl.onFoot, hour: game.dayCycle.hour };
  }
  return A.active;
}

// ---- 1. La sequenza intera, fotografata a ogni fase -------------------------
{
  const setup = await preparaArresto(0);
  out.sceneParte = !!setup;
  const bust0 = game.stats.busted || 0;
  const missionePrima = `${game.missions.active}/${game.missions.phaseDef && game.missions.phaseDef.id}`;
  const autoPrima = snapAuto();
  let autoCambiato = false;
  let canAutosaveMai = true;
  let vistoDentro = false;
  let carVisto = null;
  let ultimaFase = '';
  let n = 0;
  let t0 = performance.now();
  const fasi = [];
  const zoom = [];
  const cuffSprite = [];
  const okAttiva = await aspettaAttiva(8, 'Intera');
  t0 = performance.now();   // i tempi si contano da quando le manette si chiudono
  out.arrestoParte = okAttiva;
  if (!okAttiva) out.diagnosi = { lvl: game.wanted.level, arresting: P.arresting, bustT: P.bustT, cops: P.cops.length, pl: [Math.round(pl.x), Math.round(pl.y)], at: setup && setup.at, cop: setup && [Math.round(setup.cop.x), Math.round(setup.cop.y), setup.cop.dead, setup.cop.state], hp: pl.hp, dying: pl.dying, indoors: game.indoors, mode: game.mode.id };
  while ((A.active || performance.now() - t0 < 1000) && performance.now() - t0 < 16000) {
    if (A.active) {
      if (A.phase !== ultimaFase) {
        ultimaFase = A.phase;
        fasi.push(`${A.phase}@${((performance.now() - t0) / 1000).toFixed(1)}s`);
        await wait(0.15);   // un attimo dentro la fase, non sul bordo
        await shot(`1-${String(++n).padStart(2, '0')}-${A.phase}`);
      }
      if (S.canAutosave(game)) canAutosaveMai = false;
      if (snapAuto() !== autoPrima) autoCambiato = true;
      if (A.hidden) vistoDentro = true;
      if (A.car) carVisto = A.car;
      zoom.push(+game.camera.zoom.toFixed(2));
      cuffSprite.push(!!pl.vehicle === false);
    }
    await wait(0.1);
  }
  // Dentro la volante, mentre parte: ancora uno scatto a metà della fuga.
  out.fasi = fasi;
  out.comeFinisce = A.why;
  out.attraversaLeFasi = ['cuff', 'wait', 'walk', 'board', 'drive', 'fade'].every((f) => fasi.some((x) => x.startsWith(f)));
  out.durata = +((performance.now() - t0) / 1000).toFixed(1);
  out.durataEntroLimiti = out.durata < 12.5;
  out.giocatoreDentro = vistoDentro;
  out.mai_vehicle = cuffSprite.every(Boolean);
  out.zoomStretto = Math.max(...zoom) > 1.3;
  out.nessunAutosaveDurante = !autoCambiato && canAutosaveMai;
  await wait(0.3);
  out.finisceInBust = (game.stats.busted || 0) === bust0 + 1 && busts >= 1;
  out.sequenzaChiusa = !A.active && !A.hidden && !P.arresting && P.bustT === 0;
  out.ricercatoAzzerato = game.wanted.level === 0;
  const st = game.city.stations.length ? game.city.stations : game.city.hospitals;
  out.alCommissariato = st.some((s) => Math.hypot(s.x - pl.x, s.y - pl.y) < 120);
  out.volanteRimossa = !carVisto || !game.vehicles.includes(carVisto);
  await shot('1-99-commissariato');
  // Un arresto durante una missione la riprende dalla stessa fase (evento `busted`).
  out.missioneRipresa = missionePrima === `${game.missions.active}/${game.missions.phaseDef && game.missions.phaseDef.id}` && !!game.missions.active;
  out.autosalvaDopo = snapAuto() !== autoPrima;   // bustPlayer chiude con l'autosave
  await wait(1.2);
  out.dissolvenzaRientra = A.fade === 0;
}

// ---- 2. ESC salta, in due fasi diverse --------------------------------------
for (const quando of ['cuff', 'walk']) {
  const setup = await preparaArresto(quando === 'cuff' ? 1 : 2);
  const bust0 = game.stats.busted || 0;
  if (!setup) { out[`esc_${quando}`] = false; continue; }
  await aspettaAttiva(8, `Esc${quando}`);
  const t0 = performance.now();
  while (A.active && A.phase !== quando && performance.now() - t0 < 9000) await wait(0.05);
  const inFase = A.active && A.phase === quando;
  game.input.justPressed.add('Escape');
  await wait(0.3);
  out[`esc_${quando}`] = inFase && !A.active && (game.stats.busted || 0) === bust0 + 1 && !game.menu.open;
}
out.escSalta = out.esc_cuff && out.esc_walk;
await wait(1);

// ---- 3. Nessuna volante raggiungibile: fallback onesto ----------------------
{
  const setup = await preparaArresto(1);
  const bust0 = game.stats.busted || 0;
  const orig = A.stopPoint;
  A.stopPoint = () => null;
  await aspettaAttiva(8, 'Corta');
  out.fallbackSenzaVolante = A.active && A.mode === 'short';
  const t0 = performance.now();
  while (A.active && performance.now() - t0 < 8000) await wait(0.1);
  A.stopPoint = orig;
  out.fallbackChiude = !A.active && (game.stats.busted || 0) === bust0 + 1 && !!setup;
  await wait(1);
}

// ---- 4. Anomalia: l'agente muore prima di salire ----------------------------
{
  const setup = await preparaArresto(2);
  const bust0 = game.stats.busted || 0;
  await aspettaAttiva(8, 'Morto');
  const cop = A.cop;
  out.agenteMortoAttiva = !!cop;
  await wait(1.2);
  if (cop) cop.dead = true;
  await wait(0.3);
  // l'ultima dissolvenza non serve: l'anomalia chiude subito
  out.agenteMortoChiude = !!setup && !A.active && (game.stats.busted || 0) === bust0 + 1;
  await wait(1);
}

// ---- 5. Bug: entrare in un negozio non deve congelare la barra del fermo ----
{
  game.wanted.reset();
  P.standDown(game, true);
  const shop = game.city.shops.find((s) => game.shops.shopOpen(s, game)) || game.city.shops[0];
  if (game.shops.active) game.shops.leave(game);
  pl.revive(shop.x + shop.nx * 60, shop.y + shop.ny * 60);
  pl.weapon = 'fists';
  pl.setWeapon('fists');
  game.camera.snapTo(pl.x, pl.y);
  await wait(0.5);
  game.wanted.add(12, game);
  const cop = P.addCop(game, pl.x + 25, pl.y, 'cop', 'pistol');
  cop.x = pl.x + 25; cop.y = pl.y;
  const t0 = performance.now();
  while (P.bustT < 0.3 && performance.now() - t0 < 3000 && !A.active) await wait(0.05);
  out.barraSaliva = P.bustT >= 0.3 || A.active;
  if (!A.active) {
    game.shops.enter(shop, game);
    await wait(0.5);
    out.barraSiAzzeraNelNegozio = game.indoors && P.bustT === 0 && !P.arresting && P.bustProgress === 0;
    game.shops.leave(game);
    await wait(0.3);
  } else {
    out.barraSiAzzeraNelNegozio = 'scena partita prima: riprova';
  }
  game.wanted.reset();
  P.standDown(game, true);
}

// ---- 6. Campione: dieci posti diversi, livelli 1-3 -------------------------
// L'obiettivo è >= 9 arresti su 10 che arrivano in fondo (`comeFinisce` =
// dissolvenza *con* la volante: fasi fino a `drive`) e una durata tipica <= 8 s.
{
  const sp = game.city.spawn;
  const centri = [[0, 0], [900, 0], [-900, 200], [0, 900], [0, -900], [1500, 700], [-1500, -500], [700, -1400], [-700, 1500], [2200, 200]];
  const livelli = [12, 12, 30, 60, 12, 30, 60, 12, 12, 30];   // 1,1,2,3,1,2,3,1,1,2 stelle
  const campione = [];
  for (let i = 0; i < centri.length; i++) {
    const c = { x: sp.x + centri[i][0], y: sp.y + centri[i][1] };
    const setup = await preparaArresto(0, c, livelli[i]);
    if (!setup) { campione.push({ i, errore: 'nessun marciapiede' }); continue; }
    const area = (game.areaAt && game.areaAt(pl.x, pl.y) && game.areaAt(pl.x, pl.y).name) || '?';
    const lvl = game.wanted.level;
    await aspettaAttiva(25, `Campione${i}`);
    const t0 = performance.now();
    const fasi = [];
    let ultima = '';
    let diag = false;
    let walkDiag = null;
    while (A.active && performance.now() - t0 < 20000) {
      if (A.phase !== ultima) { ultima = A.phase; fasi.push(`${A.phase}@${((performance.now() - t0) / 1000).toFixed(1)}`); }
      if (A.phase === 'walk' && A.t > 1.6 && !diag) {
        diag = true;
        const c = A.cop, v = A.car;
        walkDiag = { cf: Math.round(Math.hypot(c.x - A.front.x, c.y - A.front.y)), pr: Math.round(Math.hypot(pl.x - A.rear.x, pl.y - A.rear.y)), cv: Math.round(Math.hypot(c.vx, c.vy)), pv: Math.round(Math.hypot(pl.vx, pl.vy)), lag: Math.round(Math.hypot(c.x - pl.x, c.y - pl.y)), carD: Math.round(Math.hypot(v.x - pl.x, v.y - pl.y)), carV: Math.round(v.speed), stuck: c.stuckT, cstate: c.state };
      }
      await wait(0.05);
    }
    campione.push({
      i, area, lvl, modo: A.mode, retries: A.retries, why: A.why,
      dur: +((performance.now() - t0) / 1000).toFixed(1), completo: A.why === 'dissolvenza' && fasi.some((f) => f.startsWith('drive')),
      fasi: fasi.join('>'), walkDiag, forzata: A.forced,
    });
    await wait(1.2);
  }
  pl.hp = 100;
  out.campione = campione;
  out.campioneCompleti = campione.filter((r) => r.completo).length;
  const durate = campione.filter((r) => r.completo).map((r) => r.dur).sort((a, b) => a - b);
  out.campioneMediana = durate.length ? durate[Math.floor(durate.length / 2)] : null;
  out.campione9su10 = out.campioneCompleti >= 9;
  out.durataTipicaEntro8s = out.campioneMediana !== null && out.campioneMediana <= 8;
}

window.__OUT = out;
window.__LOG = log;
return out;
