// Il sorpasso sulle arterie (§5.34): la stessa scena di `traffic-census` (urti, flusso,
// immobili sulle stesse cinque zone) più tre misure di corsia, prese **dall'esterno**,
// cioè dalla posizione fisica delle auto e non da `ai.lane` — così la stessa scena gira
// uguale sull'albero di partenza (dove nessuno cambia corsia) e su quello nuovo.
//
//   node .claude/tools/probe.mjs --seconds 0 --quiet --script .claude/tools/scenes/sorpasso.scene
//
//   cambiCorsiaAlMinuto  attraversamenti della mezzeria fra le due corsie, sullo stesso arco
//   quotaEsterna         quota dei campioni sull'arteria nella corsia di destra (esterna)
//   incroci              auto arrivate a 20-60 px dall'incrocio, per svolta, con quante
//                        stanno sulla corsia sbagliata (destra in corsia interna, sinistra
//                        in esterna); `sbagliataPct` è il totale
const { VEHICLE_TYPES } = await import('/src/render/sprites.js');
const { angleDiff } = await import('/src/core/math.js');
const wait = (ms) => new Promise((r) => setTimeout(r, ms));
const tally = (arr, f) => arr.reduce((a, e) => (a[f(e)] = (a[f(e)] || 0) + 1, a), {});

// Lo spawn più un ospedale per distretto: marciapiedi in zone diverse, e il
// giocatore fermo lì non finisce sotto un'auto.
const spots = [
  { x: game.player.x, y: game.player.y },
  ...game.city.hospitals.slice(0, 4).map((h) => ({ x: h.x, y: h.y })),
];

const events = [];
const ai_endHalf = (e, dir) => {
  const n = game.city.graph.nodeById(dir > 0 ? e.b : e.a);
  return (e.axis === 'v' ? n.hWidth : n.vWidth) / 2;
};
let recording = false;
// `onVehicleImpact` scatta sopra i 60 px/s di avvicinamento, cioè su un urto che
// fa danno. Chi c'è addosso lo si cerca nella griglia: se un altro mezzo è entro
// la somma delle semilunghezze l'urto è fra veicoli, altrimenti è contro un solido.
const base = game.onVehicleImpact.bind(game);
game.onVehicleImpact = function (v, impact) {
  base(v, impact);
  if (!recording || v.driver !== 'ai') return;
  const spec = VEHICLE_TYPES[v.kind];
  let other = null, od = Infinity;
  for (const o of game.vehicleGrid.queryCircle(v.x, v.y, spec.len + 60)) {
    if (o === v) continue;
    const d = Math.hypot(o.x - v.x, o.y - v.y);
    if (d < (spec.len + VEHICLE_TYPES[o.kind].len) * 0.66 && d < od) { od = d; other = o; }
  }
  const cos = Math.cos(v.angle), sin = Math.sin(v.angle);
  events.push({
    art: !!(v.ai && v.ai.edge && v.ai.edge.arterial), mid: !!(v.ai && v.ai.laneF !== undefined && v.ai.laneF !== v.ai.lane),
    vs: other ? other.kind : null, parked: other ? !!other.spot : false,
    rel: other ? +Math.abs(angleDiff(v.angle, other.angle)).toFixed(2) : null,
    fwd: other ? Math.round((other.x - v.x) * cos + (other.y - v.y) * sin) : null,
  });
};

// Offset fisico dall'asse dell'arco, positivo a destra del verso di marcia.
const offOf = (v, e, dir) => dir > 0
  ? (v.x - e.ax) * -e.dy + (v.y - e.ay) * e.dx
  : (v.x - e.bx) * e.dy + (v.y - e.by) * -e.dx;
const turnOf = (e, dir, c) => {
  if (c.edge.axis === e.axis) return c.dir === dir ? 'dritto' : 'inversione';
  const fx = dir > 0 ? e.dx : -e.dx, fy = dir > 0 ? e.dy : -e.dy;
  const gx = c.dir > 0 ? c.edge.dx : -c.edge.dx, gy = c.dir > 0 ? c.edge.dy : -c.edge.dy;
  return fx * gy - fy * gx > 0 ? 'destra' : 'sinistra';
};
const lanes = { cambi: 0, campEst: 0, campInt: 0, inc: {} };
let laneTime = 0;
const perSpot = [];
let obsTime = 0;
for (const s of spots) {
  game.player.x = s.x; game.player.y = s.y;
  game.camera.snapTo(s.x, s.y);
  await wait(16000);   // lo streaming rifà il traffico attorno alla nuova posizione
  const track = new Map();
  const laneSt = new Map();   // veicolo -> {edge, lane, seen}
  recording = true;
  const t0 = game.time;
  const sampler = setInterval(() => {
    for (const v of game.vehicles) {
      if (v.driver !== 'ai') continue;
      const e = v.ai && v.ai.edge;
      if (recording && e && e.arterial && !v.ai.scripted && !v.ai.mode) {
        const dir = v.ai.dir;
        const off = offOf(v, e, dir);
        const st = laneSt.get(v);
        if (off > 0 && off < 90) {
          if (off > 36) lanes.campEst++; else lanes.campInt++;
          if (st && st.edge === e) {
            if (st.lane === 0 && off > 41) { st.lane = 1; lanes.cambi++; }
            else if (st.lane === 1 && off < 31) { st.lane = 0; lanes.cambi++; }
          } else laneSt.set(v, { edge: e, lane: off > 36 ? 1 : 0, seen: false });
          const st2 = laneSt.get(v);
          const dEnd = e.len - (ai_endHalf(e, dir)) - v.ai.s;
          if (!st2.seen && v.ai.nextChoice && dEnd > 20 && dEnd < 60) {
            st2.seen = true;
            const k = turnOf(e, dir, v.ai.nextChoice);
            const r = lanes.inc[k] || (lanes.inc[k] = { n: 0, sbagliata: 0 });
            r.n++;
            const lane = off > 36 ? 1 : 0;   // senza isteresi: qui conta dove sta, non da dove viene
            if ((k === 'destra' && lane === 0) || (k === 'sinistra' && lane === 1)) r.sbagliata++;
          }
        }
      }
      const t = track.get(v);
      if (!t) { track.set(v, { d: 0, x: v.x, y: v.y, n: 0, why: {}, art: 0, v }); continue; }
      const w = (v.ai && v.ai.why) || '?'; t.why[w] = (t.why[w] || 0) + 1;
      if (v.ai && v.ai.edge && v.ai.edge.arterial) t.art++;
      const step = Math.hypot(v.x - t.x, v.y - t.y);
      if (step < 200) t.d += step;   // un salto è un despawn, non strada percorsa
      t.x = v.x; t.y = v.y; t.n++;
    }
  }, 250);
  // Finestra lunga: con meno di mezzo minuto un'auto ferma a un rosso (7,7 s) e a
  // quello dopo risulta "immobile" pur essendo perfettamente sana.
  await wait(34000);
  clearInterval(sampler);
  recording = false;
  const span = game.time - t0;
  obsTime += span;
  const followed = [...track.values()].filter((t) => t.n > span * 4 * 0.6);
  const perMin = followed.map((t) => Math.round(t.d / (t.n * 0.25) * 60)).sort((a, b) => a - b);
  perSpot.push({
    zona: `${s.x | 0},${s.y | 0}`,
    seguiti: followed.length,
    mediana: perMin[perMin.length >> 1] || 0,
    immobili: perMin.filter((d) => d < 400).length,
    perche: followed.filter((t) => t.d / (t.n * 0.25) * 60 < 400).map((t) => `${Object.entries(t.why).sort((a, b) => b[1] - a[1])[0][0]}/${t.art > t.n / 2 ? 'arteria' : 'strada'}/${t.v.kind}`),
  });
}

const cls = (e) => {
  if (!e.vs) return 'solido';
  if (e.parked) return 'in-sosta';
  if (e.rel < 0.7) return e.fwd > 0 ? 'tamponamento' : 'tamponato';
  if (e.rel > 2.4) return 'frontale';
  return 'incrocio/laterale';
};
const med = perSpot.map((s) => s.mediana).sort((a, b) => a - b);
return {
  osservati: +obsTime.toFixed(0),
  urtiAlMinuto: +(events.length / obsTime * 60).toFixed(1),
  perTipo: tally(events, cls),
  // dove avvengono gli urti: sull'arteria o altrove, e se a metà di un cambio corsia
  urtiSuArteria: tally(events.filter((e) => e.art), cls),
  urtiInScivolo: events.filter((e) => e.mid).length,
  // px percorsi al minuto da un veicolo: è **la** misura del flusso.
  flussoMediano: med[med.length >> 1],
  flussoMin: med[0], flussoMax: med[med.length - 1],
  immobiliTotali: perSpot.reduce((a, s) => a + s.immobili, 0),
  seguitiTotali: perSpot.reduce((a, s) => a + s.seguiti, 0),
  perZona: perSpot,
  cambiCorsiaAlMinuto: +(lanes.cambi / obsTime * 60).toFixed(1),
  quotaEsterna: +(lanes.campEst / Math.max(1, lanes.campEst + lanes.campInt)).toFixed(2),
  incroci: lanes.inc,
  sbagliataPct: (() => {
    const n = (lanes.inc.destra?.n || 0) + (lanes.inc.sinistra?.n || 0);
    const w = (lanes.inc.destra?.sbagliata || 0) + (lanes.inc.sinistra?.sbagliata || 0);
    return n ? +(100 * w / n).toFixed(0) : null;
  })(),
  fps: Math.round(game.loop.fps),
};
